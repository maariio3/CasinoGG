<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <title>Registro - CasinoGG</title>
</head>
<body class="bg-dark text-white d-flex align-items-center" style="min-height:100vh">
<div class="container" style="max-width:400px">
    <h2 class="text-center mb-2">CasinoGG</h2>
    <p class="text-center text-warning mb-4">Recibe <strong>1000€</strong> al registrarte. ¡Suscríbete a la newsletter y gana <strong>500€ extra</strong>!</p>

    {% for msg in app.flashes('error') %}
        <div class="alert alert-danger">{{ msg }}</div>
    {% endfor %}

    {{ form_start(form, {'attr': {'class': 'bg-secondary p-4 rounded'}}) }}
        <div class="mb-3">
            <label class="form-label">Correo electrónico</label>
            {{ form_widget(form.email, {'attr': {'class': 'form-control'}}) }}
            {% for error in form.email.vars.errors %}
                <div class="text-danger mt-1">{{ error.message }}</div>
            {% endfor %}
        </div>
        <div class="mb-3">
            <label class="form-label">Contraseña <small class="text-white-50">(mínimo 6 caracteres)</small></label>
            {{ form_widget(form.plainPassword, {'attr': {'class': 'form-control', 'placeholder': 'Mínimo 6 caracteres'}}) }}
            {% for error in form.plainPassword.vars.errors %}
                <div class="text-danger mt-1">{{ error.message }}</div>
            {% endfor %}
        </div>
        <div class="mb-3 form-check">
            {{ form_widget(form.newsletter, {'attr': {'class': 'form-check-input'}}) }}
            <label class="form-check-label">Suscribirme a la newsletter (+500€)</label>
        </div>
        <div class="mb-3 form-check">
            {{ form_widget(form.agreeTerms, {'attr': {'class': 'form-check-input'}}) }}
            <label class="form-check-label">Acepto los <a href="{{ path('app_terminos') }}" target="_blank" class="text-warning">términos y condiciones</a></label>
            {{ form_errors(form.agreeTerms) }}
        </div>
        <button class="btn btn-warning w-100">Registrarse</button>
    {{ form_end(form) }}
    <p class="text-center mt-3"><a href="{{ path('app_login') }}" class="text-warning">¿Ya tienes cuenta? Inicia sesión</a></p>
</div>
</body>
</html>
<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <title>Login - CasinoGG</title>
</head>
<body class="bg-dark text-white d-flex align-items-center" style="min-height:100vh">
<div class="container" style="max-width:400px">
    <h2 class="text-center mb-4">CasinoGG</h2>

    {% for msg in app.flashes('success') %}
        <div class="alert alert-success">{{ msg }}</div>
    {% endfor %}
    {% if error %}
        <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
    {% endif %}

    <form method="post" class="bg-secondary p-4 rounded">
        <div class="mb-3">
            <label class="form-label">Correo electrónico</label>
            <input type="email" name="email" class="form-control" value="{{ last_username }}" required>
        </div>
        <div class="mb-3">
            <label class="form-label">Contraseña</label>
            <input type="password" name="password" class="form-control" required>
        </div>
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
        <button class="btn btn-warning w-100">Entrar</button>
    </form>
    <p class="text-center mt-3"><a href="{{ path('app_register') }}" class="text-warning">¿No tienes cuenta? Regístrate</a></p>
</div>
</body>
</html>
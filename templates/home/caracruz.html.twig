<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <title>Cara o Cruz - CasinoGG</title>
</head>
<body class="bg-dark text-white">
<nav class="navbar navbar-dark bg-black px-4">
    <a href="{{ path('app_home') }}" class="btn btn-outline-warning btn-sm">Volver al inicio</a>
    <span class="text-warning">Saldo: <span id="saldo">{{ app.user.saldo }}</span>€</span>
</nav>

<div class="container py-4 text-center">
    <h2 class="text-warning mb-4">Cara o Cruz</h2>

    <div id="moneda" class="mx-auto d-flex align-items-center justify-content-center bg-secondary rounded-circle mb-4" style="width:120px;height:120px;font-size:3rem">🪙</div>

    <input type="number" id="apuesta" class="form-control mb-3 mx-auto" style="max-width:200px" placeholder="Apuesta" min="1">

    <div class="d-flex gap-3 justify-content-center mb-3">
        <button class="btn btn-warning px-4" onclick="jugar('cara')">Cara</button>
        <button class="btn btn-outline-warning px-4" onclick="jugar('cruz')">Cruz</button>
    </div>

    <small class="text-white-50 d-block mb-3">Acierta y gana x2</small>

    <div id="resultado" class="fs-5"></div>
</div>

<script>
    function jugar(eleccion) {
        const apuesta = document.getElementById('apuesta').value;
        if (!apuesta || apuesta <= 0) { alert('Introduce una apuesta válida'); return; }

        document.getElementById('resultado').innerHTML = '';
        document.getElementById('moneda').textContent = '🪙';

        fetch('{{ path('app_caracruz_jugar') }}', {
            method: 'POST',
            headers: {'Content-Type': 'application/x-www-form-urlencoded'},
            body: `apuesta=${apuesta}&eleccion=${eleccion}`
        })
        .then(r => r.json())
        .then(data => {
            if (data.error) {
                document.getElementById('resultado').innerHTML = `<span class="text-danger">${data.error}</span>`;
                return;
            }
            document.getElementById('moneda').textContent = data.resultado === 'cara' ? '😊' : '✝️';
            document.getElementById('saldo').textContent = data.saldo.toFixed(2);
            document.getElementById('resultado').innerHTML = data.gano
                ? `<span class="text-success">¡Ganaste ${data.ganancia.toFixed(2)}€! Salió ${data.resultado}</span>`
                : `<span class="text-danger">Perdiste. Salió ${data.resultado}</span>`;
        });
    }
</script>
</body>
</html>
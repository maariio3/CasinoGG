<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <title>CasinoGG</title>
    <style>
        .game-card { height: 300px; cursor: pointer; transition: transform 0.2s; }
        .game-card:hover { transform: scale(1.03); }
        .game-card img { width: 100%; height: 200px; object-fit: cover; }
    </style>
</head>
<body class="bg-dark text-white">

<nav class="navbar navbar-dark bg-black px-4">
    <span class="navbar-brand">CasinoGG</span>
    <div>
        {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('app_admin') }}" class="btn btn-danger btn-sm me-2">Admin</a>
        {% endif %}
        <span class="text-warning me-3">Saldo: {{ app.user.saldo }}€</span>
        <a href="{{ path('app_logout') }}" class="btn btn-outline-warning btn-sm">Salir</a>
    </div>
</nav>

<div class="container py-5">
    <h1 class="text-center text-warning mb-5">Elige tu juego</h1>
    <div class="row g-4">

        <div class="col-12 col-md-4">
            <a href="{{ path('app_ruleta') }}" class="text-decoration-none">
                <div class="game-card bg-secondary rounded overflow-hidden text-center">
                    <img src="https://estaticos-cdn.prensaiberica.es/clip/cbbb463a-ccfe-4b66-84f6-d37c06bf3802_16-9-discover-aspect-ratio_default_0.jpg" alt="Ruleta">
                    <div class="p-3">
                        <h3 class="text-warning">Ruleta</h3>
                        <p class="text-white-50">Apuesta al número o color</p>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-12 col-md-4">
            <a href="{{ path('app_slots') }}" class="text-decoration-none">
                <div class="game-card bg-secondary rounded overflow-hidden text-center">
                    <img src="https://images.unsplash.com/photo-1596838132731-3301c3fd4317?w=600" alt="Slots">
                    <div class="p-3">
                        <h3 class="text-warning">Slots</h3>
                        <p class="text-white-50">Gira y gana premios</p>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-12 col-md-4">
            <a href="{{ path('app_juegos') }}" class="text-decoration-none">
                <div class="game-card bg-secondary rounded overflow-hidden text-center">
                    <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcT5K9iOmJ1391shIeDpw9EgpzavX7iwKGnzyw&s" alt="Juegos">
                    <div class="p-3">
                        <h3 class="text-warning">Juegos</h3>
                        <p class="text-white-50">Más juegos de casino</p>
                    </div>
                </div>
            </a>
        </div>

    </div>
</div>
</body>
</html>
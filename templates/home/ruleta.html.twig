<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <title>Ruleta Europea - CasinoGG</title>
    <style>
        .num-btn { width: 45px; height: 45px; font-size: 13px; padding: 0; }
        .verde { background-color: green; color: white; }
        .rojo { background-color: #cc0000; color: white; }
        .negro { background-color: #222; color: white; border: 1px solid #555; }
        .seleccionado { outline: 3px solid yellow; }
    </style>
</head>
<body class="bg-dark text-white">
<nav class="navbar navbar-dark bg-black px-4">
    <a href="{{ path('app_home') }}" class="btn btn-outline-warning btn-sm">Volver al inicio</a>
    <span class="text-warning">Saldo: <span id="saldo">{{ app.user.saldo }}</span>€</span>
</nav>

<div class="container py-4 text-center">
    <h2 class="text-warning mb-3">Ruleta Europea</h2>

    <div id="numeroSalido" class="display-1 fw-bold mb-3 mx-auto d-flex align-items-center justify-content-center" style="width:120px;height:120px;background:white;color:#222;border-radius:10px;min-height:120px"></div>

    <div class="mb-3">
        <label class="text-white-50">Apuesta por casilla:</label>
        <input type="number" id="apuesta" class="form-control mx-auto mt-1" style="max-width:150px" placeholder="€ por casilla" min="1" onchange="actualizarTotal()">
    </div>

    <div class="alert alert-secondary py-2 mx-auto" style="max-width:300px">
        <span id="contadorSelecciones">0</span> casillas seleccionadas — Apuesta total: <strong id="apuestaTotal">0</strong>€
    </div>

    <div class="d-flex gap-2 justify-content-center mb-3">
        <button class="btn btn-danger num-btn" onclick="toggleSeleccion('rojo', this)">Rojo x2</button>
        <button class="btn num-btn negro" onclick="toggleSeleccion('negro', this)">Negro x2</button>
        <button class="btn btn-success num-btn" onclick="toggleSeleccion('verde', this)">0 x36</button>
    </div>

    <div class="d-flex flex-wrap gap-1 justify-content-center mb-3" style="max-width:400px;margin:auto">
        {% set rojos = [1,3,5,7,9,12,14,16,18,19,21,23,25,27,30,32,34,36] %}
        {% for i in 1..36 %}
            <button class="btn num-btn {% if i in rojos %}rojo{% else %}negro{% endif %}" onclick="toggleSeleccion('{{ i }}', this)">{{ i }}</button>
        {% endfor %}
    </div>

    <button class="btn btn-outline-warning btn-sm mb-3" onclick="limpiarSeleccion()">Limpiar selección</button><br>
    <button class="btn btn-warning px-4 mb-3" onclick="girar()">Girar</button>

    <div id="resultado" class="fs-5"></div>
</div>

<script>
    let selecciones = [];

    function toggleSeleccion(tipo, btn) {
        const idx = selecciones.indexOf(tipo);
        if (idx === -1) {
            selecciones.push(tipo);
            btn.classList.add('seleccionado');
        } else {
            selecciones.splice(idx, 1);
            btn.classList.remove('seleccionado');
        }
        actualizarTotal();
    }

    function actualizarTotal() {
        const apuesta = parseFloat(document.getElementById('apuesta').value) || 0;
        document.getElementById('contadorSelecciones').textContent = selecciones.length;
        document.getElementById('apuestaTotal').textContent = (selecciones.length * apuesta).toFixed(2);
    }

    function limpiarSeleccion() {
        selecciones = [];
        document.querySelectorAll('.seleccionado').forEach(b => b.classList.remove('seleccionado'));
        actualizarTotal();
    }

    function girar() {
        const apuesta = parseFloat(document.getElementById('apuesta').value);
        if (selecciones.length === 0) { alert('Selecciona al menos una casilla'); return; }
        if (!apuesta || apuesta <= 0) { alert('Introduce una apuesta válida'); return; }

        document.getElementById('resultado').innerHTML = '<span class="text-warning">Girando...</span>';
        document.getElementById('numeroSalido').innerHTML = '';
        document.getElementById('numeroSalido').style.background = 'white';
        document.getElementById('numeroSalido').style.color = '#222';

        fetch('{{ path('app_ruleta_europea_girar') }}', {
            method: 'POST',
            headers: {'Content-Type': 'application/x-www-form-urlencoded'},
            body: `apuesta=${apuesta}&selecciones=${selecciones.join(',')}`
        })
        .then(r => r.json())
        .then(data => {
            if (data.error) {
                document.getElementById('resultado').innerHTML = `<span class="text-danger">${data.error}</span>`;
                return;
            }
            const colores = {rojo: '#cc0000', negro: '#222', verde: 'green'};
            document.getElementById('numeroSalido').style.background = colores[data.color];
            document.getElementById('numeroSalido').style.color = 'white';
            document.getElementById('numeroSalido').innerHTML = data.numero;
            document.getElementById('saldo').textContent = data.saldo.toFixed(2);
            document.getElementById('resultado').innerHTML = data.gano
                ? `<span class="text-success">¡Ganaste ${data.ganancia.toFixed(2)}€! Salió ${data.numero} (${data.color})</span>`
                : `<span class="text-danger">Perdiste. Salió ${data.numero} (${data.color})</span>`;
        });
    }
</script>
</body>
</html>
<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <title>Juegos - CasinoGG</title>
    <style>
        .game-card { cursor: pointer; transition: transform 0.2s; }
        .game-card:hover { transform: scale(1.03); }
    </style>
</head>
<body class="bg-dark text-white">
<nav class="navbar navbar-dark bg-black px-4">
    <a href="{{ path('app_home') }}" class="btn btn-outline-warning btn-sm">Volver al inicio</a>
    <span class="text-warning">Saldo: {{ app.user.saldo }}€</span>
</nav>

<div class="container py-5">
    <h2 class="text-warning mb-5 text-center">Juegos</h2>
    <div class="row g-5 justify-content-center">
        <div class="col-12 col-md-5">
            <a href="{{ path('app_caracruz') }}" class="text-decoration-none">
                <div class="game-card bg-secondary rounded overflow-hidden text-center">
                    <img src="{{ asset('images/lanzarMoneda.jpg') }}" alt="Cara o Cruz" style="width:100%;height:200px;object-fit:cover">
                    <div class="p-3">
                        <h4 class="text-warning">Cara o Cruz</h4>
                        <p class="text-white-50">Acierta y gana x2</p>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-12 col-md-5">
            <a href="{{ path('app_dados') }}" class="text-decoration-none">
                <div class="game-card bg-secondary rounded overflow-hidden text-center">
                    <img src="{{ asset('images/lanzardados.jpg') }}" alt="Dados" style="width:100%;height:200px;object-fit:cover">
                    <div class="p-3">
                        <h4 class="text-warning">Dados</h4>
                        <p class="text-white-50">Alta o baja, gana x2</p>
                    </div>
                </div>
            </a>
        </div>
    </div>
</div>
</body>
</html>
<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <title>Historial - CasinoGG</title>
</head>
<body class="bg-dark text-white">
<nav class="navbar navbar-dark bg-black px-4">
    <a href="{{ path('app_home') }}" class="btn btn-outline-warning btn-sm">Volver al inicio</a>
    <span class="text-warning">Saldo: {{ app.user.saldo }}€</span>
</nav>

<div class="container py-4">
    <h3 class="text-warning mb-4">Historial de partidas</h3>

    <form method="POST" class="row g-2 mb-4">
        <div class="col-auto">
            <select name="juego" class="form-select bg-secondary text-white border-0">
                <option value="">Todos los juegos</option>
                <option value="Ruleta Europea" {% if filtroJuego == 'Ruleta Europea' %}selected{% endif %}>Ruleta Europea</option>
                <option value="Slots" {% if filtroJuego == 'Slots' %}selected{% endif %}>Slots</option>
                <option value="Cara o Cruz" {% if filtroJuego == 'Cara o Cruz' %}selected{% endif %}>Cara o Cruz</option>
                <option value="Dados" {% if filtroJuego == 'Dados' %}selected{% endif %}>Dados</option>
            </select>
        </div>
        <div class="col-auto">
            <input type="date" name="fecha_desde" class="form-control bg-secondary text-white border-0" value="{{ filtroFechaDesde }}" placeholder="Desde">
        </div>
        <div class="col-auto">
            <input type="date" name="fecha_hasta" class="form-control bg-secondary text-white border-0" value="{{ filtroFechaHasta }}" placeholder="Hasta">
        </div>
        <div class="col-auto">
            <button class="btn btn-warning">Filtrar</button>
            <a href="{{ path('app_historial') }}" class="btn btn-outline-secondary">Limpiar</a>
        </div>
    </form>

    {% if partidas is empty %}
        <p class="text-white-50">No hay partidas con esos filtros.</p>
    {% else %}
        <div class="table-responsive">
            <table class="table table-dark table-bordered">
                <thead>
                    <tr>
                        <th>Juego</th>
                        <th>Apostado</th>
                        <th>Ganancia</th>
                        <th>Resultado</th>
                        <th>Fecha</th>
                    </tr>
                </thead>
                <tbody>
                    {% for partida in partidas %}
                    <tr>
                        <td>{{ partida.juego.nombre }}</td>
                        <td>{{ partida.cantidadApostada }}€</td>
                        <td>{{ partida.resultadoObtenido }}€</td>
                        <td>
                            {% if partida.resultadoObtenido > 0 %}
                                <span class="text-success">Ganaste</span>
                            {% else %}
                                <span class="text-danger">Perdiste</span>
                            {% endif %}
                        </td>
                        <td>{{ partida.fecha|date('d/m/Y H:i') }}</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</div>
</body>
</html>